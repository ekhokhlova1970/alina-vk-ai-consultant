# ===== ProxyAPI (OpenAI-совместимый шлюз) =====
# Получить ключ: https://proxyapi.ru/ -> личный кабинет -> API-ключ
PROXY_API_KEY=

# Модель, доступная в ProxyAPI
OPENAI_MODEL=gpt-4o-mini

# ===== ВКонтакте =====
# Токен сообщества с доступом к сообщениям (управление сообществом -> Работа с API)
VK_TOKEN=
# Числовой ID сообщества (без минуса)
VK_GROUP_ID=

# ===== Необязательные настройки =====
# Ссылка на форму отдела продаж; если пусто — бот предложит официальные контакты
LEAD_FORM_URL=
# INFO | WARNING | ERROR | DEBUG
LOG_LEVEL=INFO
# 100..4096
MAX_REPLY_TOKENS=700
# 2..40
MAX_HISTORY_MESSAGES=12
# 60..86400
HISTORY_TTL_SECONDS=3600
# 5..120
REQUEST_TIMEOUT_SECONDS=30
# Путь к Markdown-базе знаний (по умолчанию data/knowledge_base.md)
KNOWLEDGE_BASE_PATH=
